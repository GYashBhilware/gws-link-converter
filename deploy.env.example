# Example deployment config. ./install.sh writes deploy.env for you; copy and edit this
# only for scripted installs:  cp deploy.env.example deploy.env && ./install.sh --config deploy.env
PROJECT_ID='my-gcp-project'
REGION='us-central1'
SERVICE_NAME='gws-link-converter'
NAME_PREFIX='link-converter'
JOB_NAME='link-converter-sync'
# Workspace BigQuery export table: project.dataset.table (may be another project)
EXPORT_TABLE='my-gcp-project.workspace_logs.activity'
# Must equal the export dataset's location (US, EU, asia-south1, ...)
BQ_LOCATION='US'
INDEX_DATASET='migration_lookup'
# Comma-separated Workspace domains allowed to sign in
ALLOWED_DOMAINS='example.com'
SYNC_CRON='*/5 * * * *'
CATCHUP_CRON='17 2 * * *'
# Blank = no alert policies
ALERT_EMAIL='admin@example.com'
# Blank = default title
APP_TITLE=''
# Advanced (optional): SCHEDULE_NAME, CATCHUP_SCHEDULE_NAME, SCHEDULER_REGION, METRIC_NAME,
# SYNC_MAX_BYTES (BigQuery byte cap for the sync job, default 20 GiB)
